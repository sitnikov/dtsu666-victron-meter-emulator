wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"
ota_password: "YourOtaPassword"
ap_fallback_password: "ChangeMe_min8chars"   # fallback access-point password (WPA2, >=8 chars)
# Needed ONLY if you enable encryption in the api: block (see dtsu666-emulator.yaml).
# Generate: openssl rand -base64 32
# api_encryption_key: "GENERATE_32_BYTE_BASE64_KEY"

# Victron Cerbo GX MQTT broker (see packages/victron_mqtt.yaml):
victron_mqtt_host: "192.168.1.50"     # IP of the Victron Cerbo GX MQTT broker on your LAN
victron_portal_id: "0123456789ab"     # VRM portal ID / Cerbo GX serial (12 hex chars)
# The Victron broker is usually plaintext LAN without auth — leave empty:
victron_mqtt_user: ""
victron_mqtt_password: ""
